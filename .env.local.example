# AWS Cognito
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3
AWS_S3_BUCKET_NAME=math-tutoring-files
AWS_REGION=us-east-1

# AWS Credentials (for API routes - use IAM role in production)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# DynamoDB
DYNAMODB_TABLE_SESSIONS=math-tutoring-sessions
DYNAMODB_TABLE_USERS=math-tutoring-users
DYNAMODB_TABLE_AVAILABILITY=math-tutoring-availability

# SES
SES_FROM_EMAIL=tutor@yourdomain.com

# Tutor Config
TUTOR_EMAIL=your-email@example.com
TUTOR_TIMEZONE=America/Los_Angeles
NEXT_PUBLIC_TUTOR_TIMEZONE=America/Los_Angeles

# Zoom
NEXT_PUBLIC_ZOOM_LINK=https://zoom.us/j/your-personal-meeting-id

# Referrals
DYNAMODB_TABLE_REFERRALS=math-tutoring-referrals

# Google Calendar sync (docs/adr/0008) — optional. Points at the Secrets
# Manager secret holding the karslowe0@gmail.com OAuth refresh token, created
# by scripts/google-oauth-authorize.mjs. If unset, this default is used and
# the app runs fine with calendar sync disabled (fails closed on freebusy,
# skips the event push).
GOOGLE_CALENDAR_SECRET_NAME=klmathprep/google-calendar

# Shared-login second tutor (docs/adr/0009) — optional. Lets a second tutor
# (e.g. Jason) manage their own availability/blocks/meeting room while
# signed in through the founder's own Cognito login, with no Cognito account
# of their own. Unset by default, which hides the "Acting as" switcher on
# /tutor/schedule and leaves booking assignment untouched.
NEXT_PUBLIC_SECOND_TUTOR_SUB=jason
NEXT_PUBLIC_SECOND_TUTOR_NAME=Jason
# Display name for the founder's own side of the "Acting as" toggle and the
# hours calendar's legend. Defaults to "Karsten" if unset.
NEXT_PUBLIC_FOUNDER_NAME=Karsten
